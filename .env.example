# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real secrets.

# Supabase — public (safe to expose; the anon key is gated by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only (full DB access, bypasses RLS; never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — transactional email (welcome + support)
RESEND_API_KEY=your-resend-api-key

# Admin gate — the single user allowed into /admin and the support-email recipient.
# Server-only (no NEXT_PUBLIC_ prefix) so it is never bundled into client JS.
ADMIN_EMAIL=admin@example.com
